# Rail configuration template — copy to .env and fill in (or run: python setup.py)

# --- Hermes API channel (recommended) ---
# true/false. If false, Rail uses Discord only.
RAIL_API_ENABLED=true

# Full endpoint of the Hermes gateway api_server (OpenAI-compatible).
# Local Hermes or SSH-tunnel case: keep localhost. Remote via VPN/tailnet:
# put the tunnel/VPN IP or HTTPS domain there (setup.py normalizes host:port).
HERMES_API_ENDPOINT=http://localhost:8642/v1/chat/completions

# Bearer key: must match platforms.api_server.extra.key (or API_SERVER_KEY)
# on the Hermes machine. Generate one: openssl rand -hex 32
HERMES_API_KEY=

# --- SSH tunnel option (setup.py option [1]) ---
# When set, start the tunnel before running Rail: ./rail-tunnel.sh
# (or manually: ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
#   -L 8642:localhost:8642 user@hermes-host)
# RAIL_TUNNEL_TARGET=user@hermes-host
# RAIL_TUNNEL_PORT=8642

# --- Discord fallback channel (optional) ---
# Needs a Discord bot with MESSAGE CONTENT intent enabled.
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=1552636595532865587
# HERMES_USER_ID=1538998656030609509
